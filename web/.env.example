# Career Ops web deployment policy
#
# Local development needs no values here. Do not set CAREER_OPS_RUNTIME locally
# unless you deliberately want to exercise the Vercel fail-closed boundary.

# Vercel only: set both as encrypted environment variables for Preview and
# Production. They are server-only; never prefix them with NEXT_PUBLIC_.
# CAREER_OPS_WEB_AUTH_USER=choose-a-private-username
# CAREER_OPS_WEB_AUTH_PASSWORD=use-a-long-random-secret

# Vercel sets VERCEL=1 automatically. This optional value is useful for a
# non-Vercel staging host that should adopt the same safe cloud boundary.
# CAREER_OPS_RUNTIME=vercel

# Do NOT set CAREER_OPS_ROOT on Vercel. The current file-backed local store,
# Windows Task Scheduler, CLI, and Playwright paths require a durable external
# persistence and worker adapter before cloud execution can be enabled.
